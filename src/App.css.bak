/* ── Variables ── */
:root {
  --yellow:       #F5D97A;
  --yellow-light: #FEFAE8;
  --orange:       #F0A85A;
  --orange-light: #FEF3E6;
  --bg:           #F7F6F1;
  --card:         #FFFFFF;
  --text:         #4c3328;
  --text-soft:    #777777;
  --border:       #E8E6DF;
  --radius:       12px;
  --shadow:       0 2px 12px rgba(0,0,0,0.06);
  --peach-dark:   #FA935b;
  --peach-light:  #FFD3A5;
}

/* ── Reset ── */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background-color: #fff7f2;
  background-image: radial-gradient(#fed5b9 1px, transparent 1px);
  background-size: 22px 22px;
  color: var(--text);
  font-size: 15px;
  line-height: 1.5;
}

/* ── Navbar ── */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rem;
  height: 64px;
  background: var(--peach-light);
  border-bottom: 3px solid #f7b672;
  position: sticky;
  top: 0;
  z-index: 100;
}

.navbar-logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text);
}

.navbar-logo img {
  height: 36px;
  width: 36px;
  object-fit: contain;
}

.navbar-links {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

/* .btn-upload {
  padding: 0.5rem 1.1rem;
  background: #FFAA6E;
  color: var(--text);
  border-radius: 8px;
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 600;
  transition: background 0.2s;
} */

.btn-upload {
  padding: 0.5rem 1.1rem;
  background: var(--text);
  color: var(--peach-light);
  border-radius: 8px;
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 600;
  transition: background 0.2s;
}

.btn-upload:hover {
  background: #FF5900;
}

.btn-signout {
  padding: 0.5rem 1rem;
  background: none;
  border: 1.5px solid #FFAA6E;
  border-radius: 8px;
  font-size: 0.9rem;
  cursor: pointer;
  color: #FF5900;
  font-family: inherit;
  transition: background 0.2s;
}

.btn-signout:hover {
  background: #FFD3A5;
}

/* ── Auth pages ── */
.auth-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.auth-split {
  display: flex;
  width: 100%;
  max-width: 860px;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 4px 32px rgba(0,0,0,0.10);
}

/* Left coloured panel */
.auth-panel {
  background: linear-gradient(180deg, var(--peach-dark) 0%, var(--peach-light) 100%);
  color: var(--text);
  padding: 3rem 2.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 1.25rem;
  min-width: 280px;
  flex: 1;
}

.auth-panel-logo {
  width: 160px;
  height: auto;
  object-fit: contain;
}

.auth-panel h2 {
  font-size: 2rem;
  font-weight: 800;
}

.auth-panel p {
  font-size: 0.95rem;
  opacity: 0.88;
  line-height: 1.6;
  max-width: 220px;
}

/* Right form panel */
.auth-box {
  background: var(--card);
  padding: 2.5rem;
  flex: 1;
  min-width: 300px;
}

.auth-box h1 {
  font-size: 1.7rem;
  margin-bottom: 0.25rem;
}

.auth-subtitle {
  color: var(--text-soft);
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.1rem;
}

.form-group label {
  display: block;
  font-weight: 500;
  margin-bottom: 0.4rem;
  font-size: 0.9rem;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 0.7rem 0.9rem;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  font-size: 0.95rem;
  font-family: inherit;
  outline: none;
  background: var(--card);
  transition: border-color 0.2s;
  resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: var(--peach-light);
}

.btn-primary {
  width: 100%;
  padding: 0.75rem;
  background: var(--peach-dark);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  margin-top: 0.5rem;
  font-family: inherit;
  transition: background 0.2s;
}

.btn-primary:hover {
  background: var(--peach-dark);
}

.btn-primary:disabled {
  background: #bbb;
  cursor: not-allowed;
}

.auth-error {
  color: #d9534f;
  font-size: 0.88rem;
  margin-bottom: 0.75rem;
  background: #fdf0f0;
  padding: 0.5rem 0.75rem;
  border-radius: 6px;
}

.auth-switch {
  text-align: center;
  margin-top: 1.5rem;
  font-size: 0.9rem;
  color: var(--text-soft);
}

.auth-switch a {
  color: var(--peach-dark);
  font-weight: 600;
  text-decoration: none;
}

.auth-switch a:hover {
  text-decoration: underline;
}

/* ── Upload recipe page ── */
.upload-container {
  max-width: 660px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.upload-container h1 {
  font-size: 1.6rem;
  margin-bottom: 0.2rem;
}

.upload-subtitle {
  color: var(--text-soft);
  margin-bottom: 1.5rem;
}

.upload-form {
  background: var(--card);
  padding: 2rem;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1.5px solid var(--border);
}

.optional {
  color: #bbb;
  font-weight: 400;
  font-size: 0.85rem;
}

.file-input {
  border: none !important;
  padding: 0 !important;
  background: none !important;
}

.photo-preview {
  margin-top: 0.75rem;
  width: 100%;
  max-height: 260px;
  object-fit: cover;
  border-radius: 8px;
  border: 1.5px solid var(--border);
}

/* ── Home feed ── */
.feed-container {
  max-width: 1080px;
  margin: 2rem auto;
  padding: 0 1.5rem;
}

.feed-header {
  margin-bottom: 1.75rem;
}

.feed-header h1 {
  font-size: 1.6rem;
  margin-bottom: 0.2rem;
}

.feed-header p {
  color: var(--text-soft);
  font-size: 0.95rem;
}

.feed-message {
  text-align: center;
  padding: 4rem 1rem;
  color: var(--text-soft);
  font-size: 1rem;
}

.recipe-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 1.25rem;
}

/* ── Recipe card ── */
.recipe-card {
  background: var(--card);
  border-radius: var(--radius);
  overflow: hidden;
  border: 1.5px solid var(--border);
  box-shadow: var(--shadow);
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.15s;
}

.recipe-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.09);
}

.card-photo {
  width: 100%;
  height: 190px;
  object-fit: cover;
}

.card-body {
  padding: 1rem;
}

.card-username {
  font-size: 0.8rem;
  color: var(--text-soft);
  margin-bottom: 0.2rem;
}

.card-title {
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 0.35rem;
}

.card-description {
  font-size: 0.88rem;
  color: var(--text-soft);
  margin-bottom: 0.75rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.btn-like {
  background: none;
  border: 1.5px solid var(--border);
  border-radius: 20px;
  padding: 0.3rem 0.8rem;
  font-size: 0.88rem;
  cursor: pointer;
  color: var(--text-soft);
  font-family: inherit;
  transition: all 0.15s;
}

.btn-like:hover {
  border-color: #e05a5a;
  color: #e05a5a;
}

.btn-like.liked {
  background: #fdf0f0;
  border-color: #e05a5a;
  color: #e05a5a;
}

.card-views {
  font-size: 0.82rem;
  color: #bbb;
}

/* ── Recipe detail page ── */
.detail-container {
  max-width: 700px;
  margin: 2rem auto;
  padding: 0 1.5rem 4rem;
}

.btn-back {
  background: none;
  border: none;
  font-size: 0.9rem;
  color: var(--peach-dark);
  cursor: pointer;
  padding: 0;
  margin-bottom: 1.25rem;
  font-weight: 600;
  font-family: inherit;
}

.detail-photo {
  width: 100%;
  max-height: 380px;
  object-fit: cover;
  border-radius: var(--radius);
  margin-bottom: 1.25rem;
  border: 1.5px solid var(--border);
}

.detail-body {
  background: var(--card);
  border-radius: var(--radius);
  padding: 1.75rem;
  box-shadow: var(--shadow);
  border: 1.5px solid var(--border);
}

.detail-title {
  font-size: 1.8rem;
  margin: 0.2rem 0 0.75rem;
}

.detail-description {
  color: var(--text-soft);
  margin-bottom: 1rem;
}

.detail-stats {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.75rem;
  padding-bottom: 1.25rem;
  border-bottom: 1.5px solid var(--border);
}

.detail-section {
  margin-bottom: 1.5rem;
}

.detail-section h2 {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-soft);
}

.detail-section p {
  color: var(--text);
  line-height: 1.75;
  white-space: pre-wrap;
}

/* ── Winner banner ── */
.winner-banner {
  background: linear-gradient(135deg, #FFF8E6 0%, #FFF0CC 100%);
  border: 2px solid #F5D97A;
  border-radius: var(--radius);
  padding: 1.25rem 1.5rem;
  margin-bottom: 2rem;
  cursor: pointer;
  transition: box-shadow 0.15s;
}

.winner-banner:hover {
  box-shadow: 0 4px 16px rgba(245, 185, 0, 0.2);
}

.winner-label {
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #B8860B;
  margin-bottom: 0.75rem;
}

.winner-content {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

.winner-photo {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 8px;
  flex-shrink: 0;
}

.winner-info {
  flex: 1;
}

.winner-title {
  font-size: 1.15rem;
  font-weight: 700;
  margin: 0.15rem 0 0.3rem;
}

.winner-description {
  font-size: 0.88rem;
  color: var(--text-soft);
  margin-bottom: 0.4rem;
}

.winner-likes {
  font-size: 0.85rem;
  color: #e05a5a;
  font-weight: 600;
}
